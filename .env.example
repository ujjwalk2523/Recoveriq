# Application Environment (development, test, staging, production)
APP_ENV=development

# Database connection (Neon / PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/recoveriq?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/recoveriq?schema=public"

# Redis Distributed Coordination
REDIS_URL="redis://localhost:6379"

# Distributed Background Worker Configuration
WORKER_ENABLED=true
WORKER_CONCURRENCY=5
WORKER_LEASE_TTL_MS=30000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_POLL_INTERVAL_MS=1000
WORKER_SHUTDOWN_TIMEOUT_MS=8000

# Authentication & Session Security
JWT_SECRET="recoveriq_super_secret_jwt_key_development_only_change_in_prod"
SESSION_SECRET="recoveriq_dev_session_secret_32_bytes_min"
API_ENCRYPTION_KEY="recoveriq_dev_encryption_key_32_b"

# AI Diagnosis Engine (Optional override)
GEMINI_API_KEY=""

# Payment Gateway Keys (Test mode default)
RAZORPAY_KEY_ID="rzp_test_recoveriq_demo"
RAZORPAY_KEY_SECRET="rzp_test_recoveriq_secret"
RAZORPAY_WEBHOOK_SECRET="whsec_recoveriq_test_secret_32bytes"

# Phase 8.3 Operational Controls & Credential Vault
PAYMENT_EXECUTION_ENABLED=true
ALLOW_LIVE_PAYMENT_TESTS=false
RECOVERIQ_SECRET_ENCRYPTION_KEY="recoveriq_secret_encryption_key_32_bytes_long"

